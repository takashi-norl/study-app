# Configure in Vercel Environment Variables and in .env.local for local cloud testing.
# Never paste server keys into client-side code or commit .env.local.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Storage owner grant is separate from family Google login. Keep it on the server only.
GOOGLE_DRIVE_REFRESH_TOKEN=
# Verify that the storage grant belongs to the intended personal account.
GOOGLE_DRIVE_OWNER_EMAIL=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_EVENTS_TAB=Events
FAMILY_ID=family-primary
# JSON array: [{"id":"parent","email":"...","name":"...","role":"parent"}, ...]
# Only verified Google emails in this list can enter the real family app.
ALLOWED_FAMILY_MEMBERS_JSON=
ANTHROPIC_API_KEY=
# Choose a model available in your Claude API account; explicit config prevents silent model/cost changes.
ANTHROPIC_MODEL=
# AI calls are disabled unless this is exactly true. Agree a budget before enabling.
AI_GENERATION_ENABLED=false
# Optional Web Push. Generate with npx web-push generate-vapid-keys.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# Optional family safety budget: default max 3 generation jobs/day (up to 300 questions each).
GENERATION_DAILY_JOB_LIMIT=3
GENERATION_MONTHLY_JOB_LIMIT=10
# Optional English pronunciation. Server-only; device speech works without a key.
ELEVENLABS_API_KEY=
# Optional voice override. Default uses the official API example voice.
ELEVENLABS_VOICE_ID=
