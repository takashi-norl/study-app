# Configure cloud credentials only in the matching Vercel project.
# Local development is demo-only; it cannot use cloud storage or paid providers.
# Never paste server keys into client-side code or commit .env.local.
APP_ENV=local
# Staging requires matching project, OAuth client, storage IDs, origin and auth-secret pin.
# See docs/STAGING_PLAN.md; do not copy production credentials into Staging.
APP_ENV_BINDINGS_JSON=
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Storage owner grant is separate from learner Google login. Keep it on the server only.
GOOGLE_DRIVE_REFRESH_TOKEN=
# Verify that the storage grant belongs to the intended personal account.
GOOGLE_DRIVE_OWNER_EMAIL=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_EVENTS_TAB=Events
WORKSPACE_ID=workspace-primary
# JSON array: [{"id":"learner-1","email":"...","name":"..."}, ...]
# Existing installations must retain their current account IDs and workspace ID.
# Bootstrap accounts only. New beta learners join through operator-issued email invitations.
REGISTERED_ACCOUNTS_JSON=
ANTHROPIC_API_KEY=
# Choose a model available in your Claude API account; explicit config prevents silent model/cost changes.
ANTHROPIC_MODEL=
# AI calls are disabled unless this is exactly true. Agree a budget before enabling.
AI_GENERATION_ENABLED=false
# Independently disabled in Staging. Unset preserves existing production behavior only.
AUDIO_GENERATION_ENABLED=false
PUSH_NOTIFICATIONS_ENABLED=false
WORKFLOW_EXECUTION_ENABLED=false
# Optional Web Push. Generate with npx web-push generate-vapid-keys.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# Optional application-wide budget: default max 3 generation jobs/day (up to 300 questions each).
GENERATION_DAILY_JOB_LIMIT=3
GENERATION_MONTHLY_JOB_LIMIT=10
# Optional English pronunciation. Server-only; device speech works without a key.
ELEVENLABS_API_KEY=
# Optional voice override. Default uses the official API example voice.
ELEVENLABS_VOICE_ID=
